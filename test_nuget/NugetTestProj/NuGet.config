<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="LocalMeshLib" value="./nuget_repo" />
  </packageSources>
  <!-- Local feed only for MeshLib: a published package of the same version must
       not silently stand in for the one under test. -->
  <packageSourceMapping>
    <packageSource key="LocalMeshLib">
      <package pattern="MeshLib" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
