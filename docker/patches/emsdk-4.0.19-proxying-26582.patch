Backport of emscripten-core/emscripten#26582 to emsdk 4.0.19.

emscripten_proxy_finish signals the proxy context's condvar after releasing its
mutex, so the waiting thread can take the mutex, see DONE, skip pthread_cond_wait,
return from emscripten_proxy_sync_with_ctx and destroy the ctx off its own stack -
leaving the signal to land on a condvar that is gone and the thread that should
have woken waiting forever. cancel_ctx has the same ordering. Fixed upstream in
emsdk 5.0.5; delete this file when EMSDK_VERSION reaches it.

--- a/system/lib/pthread/proxying.c
+++ b/system/lib/pthread/proxying.c
@@ -339,8 +339,10 @@
     pthread_mutex_lock(&ctx->sync.mutex);
     ctx->sync.state = DONE;
     remove_active_ctx(ctx);
-    pthread_mutex_unlock(&ctx->sync.mutex);
+    // Signal must come before unlock, or the waiter can see DONE and free the ctx
+    // before we unlock. https://github.com/emscripten-core/emscripten/pull/26582
     pthread_cond_signal(&ctx->sync.cond);
+    pthread_mutex_unlock(&ctx->sync.mutex);
   } else {
     // Schedule the callback on the caller thread. If the caller thread has
     // already died or dies before the callback is executed, then at least make
@@ -365,8 +367,9 @@
   if (ctx->kind == SYNC) {
     pthread_mutex_lock(&ctx->sync.mutex);
     ctx->sync.state = CANCELED;
-    pthread_mutex_unlock(&ctx->sync.mutex);
+    // Signal must be first, see the comment in emscripten_proxy_finish.
     pthread_cond_signal(&ctx->sync.cond);
+    pthread_mutex_unlock(&ctx->sync.mutex);
   } else {
     if (ctx->cb.cancel == NULL ||
         !do_proxy(ctx->cb.queue,
