@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/MeshLibC2CudaTargets.cmake")

if(APPLE)
  # CMake mistakes `libMeshLibC2Cuda.dylib` inside `MeshLib.framework` for the framework binary
  # itself and gives consumers the rpath of the framework's parent dir; pass the real library dir.
  set_property(TARGET MeshLib::MeshLibC2Cuda APPEND PROPERTY
    INTERFACE_LINK_OPTIONS "LINKER:-rpath,@PACKAGE_MR_MAIN_LIB_DIR@"
  )
endif()
