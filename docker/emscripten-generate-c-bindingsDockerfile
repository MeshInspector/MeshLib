# syntax=docker/dockerfile:1.6

# This image is used to generate C bindings (once, they are then sent to all other platforms).
# Generating C bindings requires Emscripten SDK on most platforms, see `thirdparty/mrbind/docs/generating_c.md#option-a`.
# We could choose a platform here that doesn't need EMSDK, but it's desirable to use EMSDK to check that the process actually works,
#   since this can be used on all OSes, while the EMSDK-less process only works on a few of them.

FROM emscripten/emsdk:4.0.19-arm64

COPY scripts/mrbind/install_deps_ubuntu.sh scripts/mrbind/install_deps_ubuntu.sh
COPY scripts/mrbind/clang_version.txt scripts/mrbind/clang_version.txt

# The PGO clang keg installed below; read by scripts/mrbind/* and generate.mk, which
# build mrbind and parse with it. apt is not an option here anymore: upstream's
# apt.llvm.org llvm.sh refuses jammy, which this emsdk image is based on.
ENV LLVM_PREFIX=/opt/llvm-pgo-dylib-22.1.8

RUN <<EOF
    set -e
    export DEBIAN_FRONTEND=noninteractive
    # uncomment in case of problems with the Canonical mirrors
    # sed -i 's http://ports.ubuntu.com/ubuntu-ports/ http://mirror.eu.ossplanet.net/ubuntu-ports/ ' /etc/apt/sources.list
    # PGO-optimized clang/lld 22.1.8, the same keg as the other Linux images (built in a
    # rockylinux8 container, glibc 2.28, so it runs here too). Parses for mrbind only.
    case "$(uname -m)" in
        x86_64)  CLANG_ARCH=x64;   CLANG_SHA=97b40230ff3c65e567b532b3a7cff009b0f3d397b3b5311816743a50f5641727 ;;
        aarch64) CLANG_ARCH=arm64; CLANG_SHA=41e405b76822e19b7d6cf00db648d290ad78b274fd03a970b91a0bbbb76af5d7 ;;
    esac
    curl -fsSL --retry 5 --retry-all-errors -o /tmp/clang-pgo.tar.gz "https://github.com/MeshInspector/toolchains/releases/download/clang-22.1.8-pgo-dylib-rockylinux8/clang-22.1.8-pgo-dylib-rockylinux8-${CLANG_ARCH}.tar.gz"
    echo "${CLANG_SHA}  /tmp/clang-pgo.tar.gz" | sha256sum -c -
    tar -C /opt -xzf /tmp/clang-pgo.tar.gz
    rm /tmp/clang-pgo.tar.gz
    echo '#include <filesystem>
int main() { return !std::filesystem::path("/tmp").is_absolute(); }' | ${LLVM_PREFIX}/bin/clang++ -v -xc++ - -std=c++20 -o /tmp/keg-check
    /tmp/keg-check
    rm /tmp/keg-check
    # MRBind dependencies
    ./scripts/mrbind/install_deps_ubuntu.sh
    # clean downloaded files
    apt-get clean
    rm -rf /var/lib/apt/lists/*
EOF

RUN useradd -u 8877 -m aws-user
RUN useradd -u 1001 -m github-user
USER github-user
