{
  "name": "@meshinspector/meshlib-mt",
  "version": "0.0.0",
  "description": "MeshLib geometry library compiled to WebAssembly (multi-threaded), with the complete API generated from the C++ headers.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./MeshLibC2.mjs": "./MeshLibC2.mjs",
    "./MeshLibC2.wasm": "./MeshLibC2.wasm",
    "./MeshLibC2.node.mjs": "./MeshLibC2.node.mjs",
    "./MeshLibC2.node.wasm": "./MeshLibC2.node.wasm",
    "./ffi.mjs": {
      "types": "./ffi.d.mts",
      "default": "./ffi.mjs"
    },
    "./ns/*": {
      "types": "./ns/*.d.mts",
      "default": "./ns/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.mjs",
    "index.d.mts",
    "ffi.mjs",
    "ffi.d.mts",
    "lib/",
    "ns/",
    "MeshLibC2.mjs",
    "MeshLibC2.wasm",
    "MeshLibC2.node.mjs",
    "MeshLibC2.node.wasm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "MeshLib Team <support@meshinspector.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://meshlib.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeshInspector/MeshLib.git"
  },
  "bugs": {
    "url": "https://github.com/MeshInspector/MeshLib/issues"
  },
  "keywords": [
    "mesh",
    "geometry",
    "wasm",
    "webassembly",
    "meshlib",
    "3d",
    "mesh-processing",
    "mesh-repair",
    "boolean-operations",
    "geometry-processing",
    "3d-printing",
    "stl",
    "remeshing",
    "cad",
    "point-cloud",
    "multithreaded"
  ]
}
