  <ItemGroup>
    <None Include="..\.editorconfig" />
  </ItemGroup>
  <!-- The C bindings of `source\MRPythonViewer`, with that C++ code itself; only `mrviewerpy` uses them.
       The bindings are generated by `scripts\mrbind\generate_win.bat TARGET=c` and don't exist in a fresh
       checkout, hence the wildcards. Don't add or rename files from the IDE, it would expand the
       wildcards into explicit file lists. -->
  <ItemGroup>
    <ClCompile Include="src\**\*.cpp" />
    <!-- Not with the generated sources of the same names: their own object directory, and outside of the unity files. -->
    <ClCompile Include="..\MRPythonViewer\*.cpp">
      <ObjectFileName>$(IntDir)MRPythonViewer\</ObjectFileName>
      <IncludeInUnityFile>false</IncludeInUnityFile>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="include\**\*.h" />
    <ClInclude Include="..\MRPythonViewer\*.h" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>15.0</VCProjectVersion>
    <ProjectGuid>{3B43E824-25CD-4F0C-89EF-19ECA1E9DBBA}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>MeshLibC2PythonViewer</RootNamespace>
    <!-- The analog of CMake's UNITY_BUILD, which the CMake build of this project enables too. -->
    <EnableUnitySupport>true</EnableUnitySupport>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(ProjectDir)\..\platform.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)'=='Debug'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)'=='Release'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <Import Project="$(ProjectDir)\..\common.props" />
  <PropertyGroup Label="UserMacros" />
  <!-- The CMake build receives the vcpkg headers as SYSTEM includes and doesn't see warnings
       from them, while this project compiles them itself (in its own sources), and e.g.
       Eigen triggers C5266 under `/Wall /WX`. Mark them as external and silence their warnings. -->
  <PropertyGroup>
    <ExternalIncludePath>$(VcpkgCurrentInstalledDir)\include;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>
  <!-- This project reuses the shared PCH built by the MRPch project, and force-includes MRPch.h.
       `ExceptionHandling=SyncCThrow` is `/EHs`: don't assume that `extern "C"` functions don't
       throw exceptions, because ours can throw, if no error handler is installed.
       The disabled warnings are the same as in MeshLibC2PythonViewer/CMakeLists.txt. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>$(ProjectDir)..\MRPch\MRPch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(SolutionDir)TempOutput\MRPch\$(Platform)\$(Configuration)\MRPch.pch</PrecompiledHeaderOutputFile>
      <ForcedIncludeFiles>$(ProjectDir)..\MRPch\MRPch.h</ForcedIncludeFiles>
      <Optimization>Disabled</Optimization>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>MR_COMPILING_ANY_BINDINGS;MR_COMPILING_C_BINDINGS;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <ExceptionHandling>SyncCThrow</ExceptionHandling>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableSpecificWarnings>4244;4297;4305;4804;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)src;$(ProjectDir)..;$(ProjectDir)..\..;$(ProjectDir)..\MeshLibC2\include;$(ProjectDir)..\MeshLibC2\src;%(AdditionalIncludeDirectories);$(ProjectDir)..\..\thirdparty</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>$(ProjectDir)..\MRPch\MRPch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(SolutionDir)TempOutput\MRPch\$(Platform)\$(Configuration)\MRPch.pch</PrecompiledHeaderOutputFile>
      <ForcedIncludeFiles>$(ProjectDir)..\MRPch\MRPch.h</ForcedIncludeFiles>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>MR_COMPILING_ANY_BINDINGS;MR_COMPILING_C_BINDINGS;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <ExceptionHandling>SyncCThrow</ExceptionHandling>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableSpecificWarnings>4244;4297;4305;4804;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)src;$(ProjectDir)..;$(ProjectDir)..\..;$(ProjectDir)..\MeshLibC2\include;$(ProjectDir)..\MeshLibC2\src;%(AdditionalIncludeDirectories);$(ProjectDir)..\..\thirdparty</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="MRCheckGeneratedBindingSources" BeforeTargets="ClCompile" Condition="!Exists('$(ProjectDir)src')">
    <Error Text="No generated sources found in '$(ProjectDir)src'. Run `scripts\mrbind\generate_win.bat -B TARGET=c` (from the repository root, in a VS developer command prompt) to generate them first." />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
