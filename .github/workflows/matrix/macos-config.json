{
  "include": [
    {
      "arch": "x64",
      "config": "Release",
      "compiler": "AppleClang",
      "cxx-compiler-template": "/usr/bin/clang++",
      "c-compiler-template": "/usr/bin/clang",
      "runner": ["macos-15-intel"],
      "instance": "macos-15-intel"
    },
    {
      "arch": "arm64",
      "config": "Release",
      "compiler": "AppleClang",
      "cxx-compiler-template": "/usr/bin/clang++",
      "c-compiler-template": "/usr/bin/clang",
      "runner": ["macos-14"],
      "instance": "macos-14"
    },
    {
      "arch": "arm64",
      "config": "Debug",
      "compiler": "brew-llvm22",
      "cxx-compiler-template": "BREW_PREFIX/opt/llvm@22/bin/clang++",
      "c-compiler-template": "BREW_PREFIX/opt/llvm@22/bin/clang",
      "runner": ["self-hosted", "macos", "arm64", "build"],
      "instance": "self-hosted-arm"
    },
    {
      "arch": "x64-cross",
      "config": "Release",
      "compiler": "AppleClang",
      "cxx-compiler-template": "/usr/bin/clang++",
      "c-compiler-template": "/usr/bin/clang",
      "runner": ["self-hosted", "macos", "arm64", "crossplatform-build"],
      "instance": "self-hosted-arm-x64-native",
      "cross-osx-arch": "x86_64"
    }
  ]
}
