@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost 1.73)
find_dependency(Eigen3)
find_dependency(fmt 8)
find_dependency(JsonCpp)
find_dependency(phmap 2.0)
find_dependency(spdlog 1.9)
find_dependency(TBB 2020.1)
find_dependency(tl-expected)
if(NOT EMSCRIPTEN AND NOT "@MR_MIMALLOC_OVERRIDE@" AND WIN32)
  find_dependency(mimalloc)
endif()

# static builds require to find private dependencies
if(EMSCRIPTEN)
  # libzip on Emscripten is unable to resolve its dependencies by itself
  find_package(MbedTLS 1.0 REQUIRED)
  find_package(ZLIB REQUIRED)
  find_dependency(libzip)
  find_dependency(zlib-ng)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MRMeshTargets.cmake")

if(NOT EMSCRIPTEN AND NOT "@MR_MIMALLOC_OVERRIDE@" AND NOT WIN32 AND NOT TARGET mimalloc)
  # MeshLib's own non-override mimalloc next to MRMesh, see mr_find_mimalloc
  get_target_property(_mr_configs MeshLib::MRMesh IMPORTED_CONFIGURATIONS)
  list(GET _mr_configs 0 _mr_config)
  get_target_property(_mr_mesh MeshLib::MRMesh IMPORTED_LOCATION_${_mr_config})
  get_filename_component(_mr_lib_dir "${_mr_mesh}" DIRECTORY)
  find_library(MESHLIB_MIMALLOC_LIBRARY NAMES MRMimalloc PATHS "${_mr_lib_dir}" NO_DEFAULT_PATH REQUIRED)
  add_library(mimalloc SHARED IMPORTED)
  set_target_properties(mimalloc PROPERTIES IMPORTED_LOCATION "${MESHLIB_MIMALLOC_LIBRARY}")
  if(DEFINED MESHLIB_THIRDPARTY_INCLUDE_DIR)
    set_target_properties(mimalloc PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${MESHLIB_THIRDPARTY_INCLUDE_DIR}")
  endif()
endif()

check_required_components(MRMesh)
