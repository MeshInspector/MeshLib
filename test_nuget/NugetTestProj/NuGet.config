<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- CI drops the freshly packed MeshLib*.nupkg here. -->
    <add key="LocalMeshLib" value="./nuget_repo" />
  </packageSources>
  <!-- Resolve MeshLib from the local feed only, so an already-published package
       of the same version can never stand in for the one under test. -->
  <packageSourceMapping>
    <packageSource key="LocalMeshLib">
      <package pattern="MeshLib" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
