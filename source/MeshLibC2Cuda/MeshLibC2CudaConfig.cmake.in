@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/MeshLibC2CudaTargets.cmake")

if(APPLE)
  # Same rpath fix as in `MeshLibC2Config.cmake.in`: this file name contains the framework name
  # too, so CMake would point a consumer's rpath at the framework's parent directory.
  set_property(TARGET MeshLib::MeshLibC2Cuda APPEND PROPERTY
    INTERFACE_LINK_OPTIONS "LINKER:-rpath,@PACKAGE_MR_MAIN_LIB_DIR@"
  )
endif()
